# Copy to ".env" for local testing / running login.js.
# On Fly.io these become secrets instead (see FLY_DEPLOY.md).

TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Only needed after running "npm run login" once:
TELEGRAM_SESSION_STRING=

# Your channel's @username (if public) or numeric ID (if private)
TELEGRAM_CHANNEL=

PORT=3000

# Optional: Set to true if you want cleanup summary notifications posted to your channel (default: false / 100% silent)
ENABLE_CHANNEL_NOTIFICATIONS=false

# Optional: Bot token from @BotFather if you want real interactive UI buttons [1️⃣][2️⃣][3️⃣] under /song menus
# If omitted, the server uses native clickable /1 - /5 command links
TELEGRAM_BOT_TOKEN=
